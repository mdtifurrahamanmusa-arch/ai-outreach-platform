package main

import (
	"fmt"
	"os"
	"strings"

	"github.com/gofiber/fiber/v2"
	"github.com/gofiber/fiber/v2/middleware/cors"
	"github.com/gofiber/fiber/v2/middleware/logger"
	openai "github.com/sashabaranov/go-openai"
)

type Contact struct {
	ID      string `json:"id"`
	Name    string `json:"name"`
	Email   string `json:"email"`
	Phone   string `json:"phone"`
	Segment string `json:"segment"`
	Notes   string `json:"notes"`
}

type DraftRequest struct {
	Product  string `json:"product"`
	Audience string `json:"audience"`
	Tone     string `json:"tone"`
	Goal     string `json:"goal"`
	Language string `json:"language"`
	Style    string `json:"style"`
	Offer    string `json:"offer"`
}

type DraftResponse struct {
	Message string `json:"message"`
}

type Campaign struct {
	ID        string   `json:"id"`
	Title     string   `json:"title"`
	Product   string   `json:"product"`
	Audience  string   `json:"audience"`
	Tone      string   `json:"tone"`
	Message   string   `json:"message"`
	ContactIDs []string `json:"contact_ids"`
	CreatedAt string   `json:"created_at"`
}

var contacts = []Contact{
	{ID: "c1", Name: "Rahim", Email: "rahim@gmail.com", Phone: "+8801712345678", Segment: "Lead", Notes: "Interested in digital growth services"},
	{ID: "c2", Name: "Karim", Email: "karim@gmail.com", Phone: "+8801812345678", Segment: "Client", Notes: "Needs a sales automation system"},
	{ID: "c3", Name: "Nusrat", Email: "nusrat@gmail.com", Phone: "+8801912345678", Segment: "Prospect", Notes: "Interested in AI automation"},
}

var campaigns = []Campaign{}

func main() {
	app := fiber.New()
	app.Use(cors.New())
	app.Use(logger.New())

	apiKey := os.Getenv("OPENAI_API_KEY")
	if apiKey == "" {
		fmt.Println("Warning: OPENAI_API_KEY is not set. The app will use demo AI output.")
	}

	app.Get("/", func(c *fiber.Ctx) error {
		return c.JSON(fiber.Map{
			"app":     "AI Outreach Platform",
			"status":  "running",
			"message": "Go to /api/health and use the /api/ai/draft endpoint.",
		})
	})

	app.Get("/api/health", func(c *fiber.Ctx) error {
		return c.JSON(fiber.Map{"status": "ok"})
	})

	app.Get("/api/contacts", func(c *fiber.Ctx) error {
		return c.JSON(contacts)
	})

	app.Post("/api/contacts", func(c *fiber.Ctx) error {
		var contact Contact
		if err := c.BodyParser(&contact); err != nil {
			return c.Status(400).JSON(fiber.Map{"error": "Invalid contact payload"})
		}
		contact.ID = "c" + fmt.Sprintf("%d", len(contacts)+1)
		contacts = append(contacts, contact)
		return c.Status(201).JSON(contact)
	})

	app.Post("/api/ai/draft", func(c *fiber.Ctx) error {
		var req DraftRequest
		if err := c.BodyParser(&req); err != nil {
			return c.Status(400).JSON(fiber.Map{"error": "Invalid payload"})
		}

		prompt := buildPrompt(req)
		message, err := generateAIText(apiKey, prompt)
		if err != nil {
			return c.Status(500).JSON(fiber.Map{"error": err.Error()})
		}

		return c.JSON(DraftResponse{Message: message})
	})

	app.Get("/api/campaigns", func(c *fiber.Ctx) error {
		return c.JSON(campaigns)
	})

	app.Post("/api/campaigns", func(c *fiber.Ctx) error {
		var req struct {
			Title      string   `json:"title"`
			Product    string   `json:"product"`
			Audience   string   `json:"audience"`
			Tone       string   `json:"tone"`
			Message    string   `json:"message"`
			ContactIDs []string `json:"contact_ids"`
		}

		if err := c.BodyParser(&req); err != nil {
			return c.Status(400).JSON(fiber.Map{"error": "Invalid campaign payload"})
		}

		campaign := Campaign{
			ID:         "cmp-" + fmt.Sprintf("%d", len(campaigns)+1),
			Title:      req.Title,
			Product:    req.Product,
			Audience:   req.Audience,
			Tone:       req.Tone,
			Message:    req.Message,
			ContactIDs: req.ContactIDs,
			CreatedAt:  "now",
		}

		campaigns = append(campaigns, campaign)
		return c.Status(201).JSON(campaign)
	})

	app.Post("/api/campaigns/:id/send", func(c *fiber.Ctx) error {
		id := c.Params("id")
		campaign := findCampaignByID(id)
		if campaign == nil {
			return c.Status(404).JSON(fiber.Map{"error": "Campaign not found"})
		}

		recipients := []string{}
		for _, contactID := range campaign.ContactIDs {
			for _, contact := range contacts {
				if contact.ID == contactID {
					recipients = append(recipients, contact.Name+" <"+contact.Email+">")
				}
			}
		}

		return c.JSON(fiber.Map{
			"message":    "Campaign queued for delivery",
			"campaign_id": campaign.ID,
			"recipients": recipients,
			"draft":      campaign.Message,
		})
	})

	if err := app.Listen(":3001"); err != nil {
		panic(err)
	}
}

func buildPrompt(req DraftRequest) string {
	if req.Language == "" {
		req.Language = "Bangla"
	}
	if req.Tone == "" {
		req.Tone = "Professional but friendly"
	}
	if req.Style == "" {
		req.Style = "Short and direct"
	}

	return fmt.Sprintf(`
Generate a sales outreach message.

Product/Service: %s
Audience: %s
Tone: %s
Goal: %s
Language: %s
Style: %s
Offer: %s

Requirements:
- Use natural conversational tone
- Keep it concise and persuasive
- Sound helpful, not spammy
- Include a clear CTA
- No markdown
- Output only the actual message text
`, req.Product, req.Audience, req.Tone, req.Goal, req.Language, req.Style, req.Offer)
}

func generateAIText(apiKey, prompt string) (string, error) {
	if apiKey == "" {
		return "Hello! I help businesses grow through AI-powered communication and outreach. Would you like to explore a custom strategy for your business?", nil
	}

	client := openai.NewClient(apiKey)
	resp, err := client.CreateChatCompletion(openai.ChatCompletionRequest{
		Model: openai.GPT3Dot5Turbo,
		Messages: []openai.ChatCompletionMessage{
			{Role: openai.ChatMessageRoleUser, Content: prompt},
		},
		Temperature: 0.7,
	})
	if err != nil {
		return "", err
	}
	if len(resp.Choices) == 0 {
		return "", fmt.Errorf("no response from OpenAI")
	}

	text := resp.Choices[0].Message.Content
	return strings.TrimSpace(text), nil
}

func findCampaignByID(id string) *Campaign {
	for i := range campaigns {
		if campaigns[i].ID == id {
			return &campaigns[i]
		}
	}
	return nil
}
